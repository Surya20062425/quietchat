# Relay (apps/relay)
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Offline queue TTL in ms — default 7 days (PRD open question #3)
QUEUE_TTL_MS=604800000
# Max ciphertext bytes before base64 (PRD FR-19)
MAX_CIPHERTEXT_BYTES=4096
# Shared secret for dev tokens. UNSET = PoC mode (accepts bare userIds).
# Set this before any real deployment; Supabase JWT verification arrives in phase 2.
RELAY_DEV_SECRET=
# Set to 0 to require an accepted contact before messaging (default: allow all in PoC)
ALLOW_ALL_RECIPIENTS=1

# Web (apps/web)
VITE_RELAY_URL=http://localhost:3001
